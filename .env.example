APP_ENV=development
APP_VERSION=dev
API_PUBLIC_BASE_URL=http://api.localhost
FRONTEND_ORIGINS=http://localhost,http://localhost:5173,http://shop.localhost
ADMIN_ORIGINS=http://admin.localhost
TRUSTED_HOSTS=api.localhost,localhost,127.0.0.1,testserver
INTERNAL_ALLOWED_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12
DATABASE_URL=postgresql+asyncpg://kosto_vet:kosto_vet@postgres:5432/kosto_vet
FIXED_DELIVERY_PRICE_MINOR=50000
COOKIE_SECURE=false
CUSTOMER_SESSION_SECRET=replace-with-independent-random-32-byte-secret
STAFF_SESSION_SECRET=replace-with-independent-random-32-byte-secret
CSRF_SECRET=replace-with-independent-random-32-byte-secret

MOYSKLAD_MODE=disabled
MOYSKLAD_ACCESS_TOKEN=
MOYSKLAD_WAREHOUSE_ID=
MOYSKLAD_PRICE_TYPE_ID=
MOYSKLAD_CATALOG_SYNC_INTERVAL_SECONDS=900
MOYSKLAD_STOCK_SYNC_INTERVAL_SECONDS=60

ROBOKASSA_MODE=disabled
FISCALIZATION_MODE=disabled
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_HASH_ALGORITHM=sha256

YANDEX_OAUTH_MODE=disabled
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT_URI=http://api.localhost/api/v1/customer/auth/yandex/callback

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=https://s3.regru.cloud
S3_REGION=
S3_ORIGINALS_BUCKET=
S3_PUBLIC_MEDIA_BUCKET=
S3_PUBLIC_BASE_URL=
